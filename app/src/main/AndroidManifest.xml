<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to see Android Auto, Play Services and AA Experiments. The app has no network permission. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_descriptor"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AATweaker">

        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FlagsActivity"
            android:parentActivityName=".HomeActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DiagnosticsActivity"
            android:parentActivityName=".HomeActivity"
            android:theme="@style/Theme.AATweaker.ActionBar" />

        <activity
            android:name=".relay.RelayActivity"
            android:parentActivityName=".HomeActivity"
            android:theme="@style/Theme.AATweaker.ActionBar" />

        <!-- Quick Settings tile: restart Android Auto and the head unit server in one tap. -->
        <service
            android:name=".RestartTileService"
            android:exported="true"
            android:icon="@drawable/ic_restart"
            android:label="@string/tile_restart"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Message relay: mirrors Messenger notifications in a form Android Auto accepts. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name=".relay.RelayService"
            android:exported="true"
            android:label="@string/relay_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".relay.RelayReceiver"
            android:exported="false" />

    </application>

</manifest>
